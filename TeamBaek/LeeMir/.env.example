# Optional server-only RPC credential. Public read probes can run without it.
TRONGRID_API_KEY=
NVIDIA_API_KEY=
SUN_API_KEY=
# Optional reviewed local JustLend MCP entrypoint. Keep this server-side.
JUSTLEND_MCP_ENTRY=
# Optional public Nile address for read-only doctor probes.
NILE_WALLET_ADDRESS=
# Required for Nile approval-mode trading. Generate a unique 32-byte hex key locally;
# never commit or share the value. Missing key keeps approval endpoints unavailable.
GWDC_APPROVAL_LEDGER_KEY_HEX=
# Optional local, ignored SQLite path (default: tmp/nile-approval.sqlite).
GWDC_APPROVAL_LEDGER_PATH=
API_PORT=8787
UI_PORT=5173
