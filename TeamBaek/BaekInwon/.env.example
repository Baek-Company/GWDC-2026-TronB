# 복사해서 .env.local로 쓴다: Copy-Item .env.example .env.local
# 비밀 값은 .env.local에만 넣는다. VITE_ 접두사 변수에는 비밀 값을 넣지 않는다.

# --- LLM ---
LLM_PROVIDER=nim                 # nim | bai(Bank of AI, 크레딧 충전 필요) | template
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_API_KEY=
NIM_MODEL=nvidia/nemotron-3-super-120b-a12b
LLM_TIMEOUT_MS=45000

# Bank of AI (B.AI) LLM Service — 해커톤 "TRON LLM". OpenAI 호환. https://docs.b.ai/llmservice/api/
BAI_BASE_URL=https://api.b.ai/v1
BAI_API_KEY=
BAI_MODEL=gpt-5.6-terra

# --- 체인 조회 ---
TRONGRID_API_KEY=

# --- MCP (선택) ---
# JustLend/USDD 공식 MCP는 시작 시 ~/.agent-wallet 지갑을 자동 생성한다.
# 사용하려면 로컬에서 버전 고정해 설치한 뒤 실행 명령을 넣는다. 비우면 직접 온체인 조회를 쓴다.
MCP_JUSTLEND_COMMAND=
MCP_USDD_COMMAND=
MCP_TRONGRID_ENABLED=true

# --- 실행 모드 ---
DATA_MODE=synthetic              # synthetic | live
ENABLE_NILE_EXECUTION=false      # 지갑·Nile TRX 준비 후 true
API_PORT=8787
